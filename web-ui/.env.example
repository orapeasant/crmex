# Copy to web-ui/.env (gitignored). Values are baked into the browser bundle, so
# VITE_SUPABASE_ANON_KEY must be the *anon* (public) key — never the service role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_CORE_SERVER_URL=http://localhost:8080/api/v1
