{
  "name": "crmex-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "sync": "node scripts/copy-nodejs-payload.mjs && npx cap sync android",
    "open": "npx cap open android",
    "assembleDebug": "cmd /c gradlew.bat assembleDebug",
    "installDebug": "cmd /c gradlew.bat installDebug"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@southdevs/capacitor-google-auth": "^7.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "capacitor-nodejs": "https://github.com/hampoelz/Capacitor-NodeJS/releases/download/v1.0.0-beta.10/capacitor-nodejs.tgz",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shared-ui": "file:../shared-ui"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
