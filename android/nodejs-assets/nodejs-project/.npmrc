# baileys declares `sharp` as a peer dependency for optional image thumbnail
# processing. sharp ships a prebuilt native .node binary per platform/ABI —
# exactly the nodejs-mobile risk crmex.md §10.4 warns about ("a native
# module sneaks in as a transitive dependency"). We never build link
# previews or sticker thumbnails, and Baileys feature-detects sharp's
# absence at runtime rather than requiring it, so it is deliberately
# excluded here. legacy-peer-deps=true restores npm's pre-v7 behavior of not
# auto-installing peer dependencies (verified: `npm install` under this
# config produces zero .node files anywhere in the tree — see android/README.md
# "Step 0 spike" section for how this was confirmed).
legacy-peer-deps=true
