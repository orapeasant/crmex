# CRMEX core-server — environment configuration
# Copy to .env for local development. Never commit a real .env (it is
# gitignored at the repo root already).

# --- Supabase project ---------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API -> Project API keys -> service_role (SECRET —
# bypasses Row Level Security; never ship this to a client or the Android app).
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase tooling (psql / supabase CLI; not read by core-server) --------
# Project ref = the subdomain of SUPABASE_URL.
SUPABASE_PROJECT_REF=
# Project Settings -> Database -> Connection string (URI). Use the pooler URI
# if your network is IPv4-only. Used as: psql "$DATABASE_URL"
# SECRET — contains the database password.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=
# supabase CLI token: https://supabase.com/dashboard/account/tokens
# (or run `supabase login`). Used for `supabase link` / `db push` / `db pull`.
SUPABASE_ACCESS_TOKEN=

# --- Server ---------------------------------------------------------------
PORT=8080
# Seconds a signed download URL for a storage object stays valid. Keep short
# per crmex.md §3.3/§4 — signed URLs are bearer credentials.
SIGNED_URL_TTL_SECONDS=300
# Comma-separated browser origins allowed to call the API. Defaults to the
# Capacitor WebView origins (https://localhost, capacitor://localhost).
# CORS_ALLOWED_ORIGINS=https://localhost,capacitor://localhost

# --- Provider selection (crmex.md §6) --------------------------------------
# One of: anthropic | fake
LLM_PROVIDER=anthropic
# One of: openai | fake
IMAGE_GEN_PROVIDER=openai
# One of: unsplash | fake
IMAGE_SEARCH_PROVIDER=unsplash

# --- Provider credentials ---------------------------------------------------
# Anthropic Console -> Settings -> API Keys (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# Optional: route through a LiteLLM proxy (no trailing /v1 for Anthropic)
ANTHROPIC_BASE_URL=
# OpenAI Platform -> API keys (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Optional: OpenAI-compatible gateway, e.g. http://localhost:4000
OPENAI_BASE_URL=
# Unsplash -> Your Apps -> create an app -> Access Key
# (https://unsplash.com/oauth/applications)
UNSPLASH_ACCESS_KEY=

# --- Optional model / timeout overrides (names only, never keys) ------------
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929   # contact matching
# ANTHROPIC_DRAFT_MODEL=claude-haiku-4-5       # message drafting
# OPENAI_IMAGE_MODEL=gpt-image-1
# IMAGE_PROVIDER_TIMEOUT_MS=120000

# --- Misc -------------------------------------------------------------------
NODE_ENV=development
